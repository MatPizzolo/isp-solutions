# Tenant activo. Tiene que estar registrado en src/tenants/index.ts.
# Si no se define, se usa "zonda".
NEXT_PUBLIC_TENANT=zonda

# Modo demo. En true muestra el badge "Demo" y el panel flotante
# con los DNIs de prueba, las credenciales del admin y "Restablecer demo".
# En una instalación real de un ISP esto va en false.
NEXT_PUBLIC_DEMO_MODE=true
